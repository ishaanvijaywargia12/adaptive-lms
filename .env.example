# ─── Copy this file to .env and fill in real values ──────────────────────────
# DO NOT commit .env — it is in .gitignore

# ─── PostgreSQL (Neon.tech free tier) ─────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── Spring Datasource ────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ─── Redis (Upstash free tier) ────────────────────────────────────────────────
SPRING_DATA_REDIS_URL=
SPRING_REDIS_HOST=
SPRING_REDIS_PASSWORD=

# ─── Object Storage (MinIO / S3-compatible) ───────────────────────────────────
MINIO_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ─── AI / RAG ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
QDRANT_HOST=
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_TLS=true

# ─── Auth (Spring Authorization Server — self-hosted in the backend) ──────────
APP_BASE_URL=                    # e.g. https://adaptive-lms-backend.onrender.com
APP_JWT_SECRET=                  # 32+ char random string for HMAC signing (dev only)

# ─── Application ──────────────────────────────────────────────────────────────
LMS_EVENTS_MODE=sync             # 'kafka' or 'sync' (use sync for free-tier demo)
LMS_DEFAULT_TENANT=demo

# ─── Mail (optional — failures are non-fatal) ─────────────────────────────────
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://ishaanvijaywargia12.github.io,http://localhost:5173

# ─── Frontend (Vite build-time) ───────────────────────────────────────────────
VITE_API_URL=                    # e.g. https://adaptive-lms-backend.onrender.com/api
VITE_AUTH_AUTHORITY=             # e.g. https://adaptive-lms-backend.onrender.com
VITE_AUTH_CLIENT_ID=lms-frontend
VITE_TENANT_ID=demo
VITE_WS_URL=                     # e.g. wss://adaptive-lms-backend.onrender.com/ws

# ─── Demo credentials (set to match seeded users) ────────────────────────────
# student@demo.com / Demo1234!
# instructor@demo.com / Demo1234!
# admin@demo.com / Demo1234!
