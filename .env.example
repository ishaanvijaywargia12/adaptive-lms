# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=lmsdb
POSTGRES_USER=lmsuser
POSTGRES_PASSWORD=lmspassword

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispassword

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@lms.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost/api
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_WS_URL=ws://localhost/ws

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost
APP_PLAGIARISM_THRESHOLD=70
APP_JWT_EXPIRY_SECONDS=3600

# ─── Spring Boot ─────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker

# ─── OpenAI / RAG ─────────────────────────────────────────────────────────────
# Replace with your real OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
